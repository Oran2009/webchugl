{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "src/runtime",
    "rootDir": "src/runtime",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "typeRoots": ["src/runtime/types", "node_modules/@webgpu"]
  },
  "include": ["src/runtime/webchugl-esm.ts", "src/runtime/webchugl.ts", "src/runtime/lib/**/*.ts", "src/runtime/types/**/*.d.ts"],
  "exclude": ["node_modules", "emsdk-*", "chuck", "chugl", "dist"]
}
